# Frontend env (server-side only — DO NOT prefix with NEXT_PUBLIC_)
# Get a free key at https://console.groq.com
# Original ask: llama-3.3-70b-versatile. If your key has access, set:
#   GROQ_MODEL=llama-3.3-70b-versatile
# If not, leave unset to default to openai/gpt-oss-120b (120B, same tier).
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Public API base (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/feed
